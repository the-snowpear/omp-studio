+import { describe, expect, test } from "bun:test";
+import type { AgentSession } from "@oh-my-pi/pi-coding-agent/session/agent-session";
+import { StudioTreeService } from "@oh-my-pi/pi-coding-agent/studio/services/tree-service";
+
+describe("WP-034 StudioTreeService", () => {
+	test("projects a path-free tree and preserves the active leaf", () => {
+		const session = {
+			sessionManager: {
+				getLeafId: () => "entry-1",
+				getTree: () => [
+					{
+						entry: {
+							type: "message",
+							id: "entry-1",
+							parentId: null,
+							timestamp: "2026-08-12T00:00:00.000Z",
+							message: { role: "user", content: "secret path C:/private" },
+						},
+						label: "Start",
+						children: [],
+					},
+				],
+			},
+		} as unknown as AgentSession;
+		const result = new StudioTreeService(session).getTree();
+		expect(result).toEqual({
+			leafId: "entry-1",
+			roots: [
+				{
+					id: "entry-1",
+					parentId: null,
+					type: "message",
+					timestamp: "2026-08-12T00:00:00.000Z",
+					label: "Start",
+					role: "user",
+					children: [],
+				},
+			],
+		});
+		expect(JSON.stringify(result)).not.toContain("C:/private");
+	});
+});
