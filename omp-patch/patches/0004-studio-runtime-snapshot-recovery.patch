@@ -0,0 +1,85 @@
+import {
+	type StudioOperatorStateSnapshot,
+	type StudioSnapshotResponse,
+	stableEmptyManifestHash,
+} from "./bridge-protocol";
+import type { StudioHostRuntime } from "./studio-host-mode";
+
+function goalStatus(status: string): "off" | "active" | "paused" | "complete" {
+	switch (status) {
+		case "active":
+			return "active";
+		case "paused":
+		case "budget-limited":
+			return "paused";
+		case "complete":
+			return "complete";
+		default:
+			return "off";
+	}
+}
+
+function cloneSnapshot(snapshot: StudioOperatorStateSnapshot): StudioOperatorStateSnapshot {
+	return structuredClone(snapshot);
+}
+
+export class StudioStateProjector {
+	readonly #runtime: StudioHostRuntime;
+
+	constructor(runtime: StudioHostRuntime) {
+		this.#runtime = runtime;
+	}
+
+	get stateVersion(): number {
+		return 0;
+	}
+
+	get lastEventSeq(): number {
+		return 0;
+	}
+
+	snapshot(): StudioOperatorStateSnapshot {
+		const plan = this.#runtime.session.getPlanModeState();
+		const goal = this.#runtime.session.getGoalModeState();
+		const vibe = this.#runtime.session.getVibeModeState();
+		const activeMode = goal?.enabled ? "goal" : plan?.enabled ? "plan" : vibe?.enabled ? "vibe" : "normal";
+		const snapshot: StudioOperatorStateSnapshot = {
+			runtimeId: this.#runtime.runtimeId,
+			runtimeEpoch: this.#runtime.runtimeEpoch,
+			stateVersion: this.stateVersion,
+			sessionId: this.#runtime.sessionId,
+			isStreaming: this.#runtime.session.isStreaming,
+			isCompacting: this.#runtime.session.isCompacting,
+			activeMode,
+			pendingMessages: 0,
+			activeCommandIds: [],
+			agentsRevision: 0,
+			jobsRevision: 0,
+			agents: [],
+			jobs: [],
+		};
+		if (plan !== undefined) snapshot.plan = { status: plan.enabled ? "active" : "off" };
+		if (goal !== undefined) {
+			snapshot.goal = {
+				status: goalStatus(goal.goal.status),
+				objective: goal.goal.objective,
+				tokenBudget: goal.goal.tokenBudget,
+				tokensUsed: goal.goal.tokensUsed,
+			};
+		}
+		if (vibe !== undefined) snapshot.vibe = { enabled: vibe.enabled, workerAgentIds: [] };
+		return cloneSnapshot(snapshot);
+	}
+
+	response(requestId: string): StudioSnapshotResponse {
+		return {
+			type: "studio.snapshot",
+			requestId,
+			snapshot: this.snapshot(),
+			commandManifestHash: stableEmptyManifestHash("commands"),
+			capabilityHash: stableEmptyManifestHash("capabilities"),
+			lastEventSeq: this.lastEventSeq,
+			terminalReceipts: [],
+		};
+	}
+}
