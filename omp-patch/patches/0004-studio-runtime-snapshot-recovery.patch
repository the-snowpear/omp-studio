+export function parseStudioSnapshotRequest(value: unknown): StudioSnapshotRequest {
+	const input = record(value);
+	exactKeys(input, ["type", "requestId", "runtimeEpoch", "operation"]);
+	const operation = record(input.operation);
+	exactKeys(operation, ["kind"]);
+	if (
+		input.type !== "studio.request" ||
+		!nonEmptyString(input.requestId) ||
+		!Number.isSafeInteger(input.runtimeEpoch) ||
+		(input.runtimeEpoch as number) <= 0 ||
+		operation.kind !== "runtime.snapshot"
+	) {
+		throw new StudioFrameError("Invalid Studio snapshot request");
+	}
+	return input as unknown as StudioSnapshotRequest;
+}
