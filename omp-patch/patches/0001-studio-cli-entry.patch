+it("classifies studio-host as an interactive host before opening auth storage", async () => {
+	const previous = setInteractiveHost(false);
+	const stop = new Error("stop after studio-host classification");
+	let observedTimeout: number | undefined;
+	const parsed = parseArgs(["--mode", "studio-host"]);
+	parsed.noExtensions = true;
+
+	try {
+		await expect(
+			runRootCommand(parsed, ["--mode", "studio-host"], {
+				discoverAuthStorage: async () => {
+					observedTimeout = getDbBusyTimeoutMs();
+					throw stop;
+				},
+			}),
+		).rejects.toBe(stop);
+	} finally {
+		setInteractiveHost(previous);
+	}
+
+	expect(observedTimeout).toBe(5000);
+});
