 	constructor(private readonly getBaseContext: () => CustomToolContext) {}
 
 	getContext(toolCall?: ToolCallContext): AgentToolContext {
+		const ui = this.#uiFactory === undefined ? this.#uiContext : this.#uiFactory(toolCall);
 		return {
