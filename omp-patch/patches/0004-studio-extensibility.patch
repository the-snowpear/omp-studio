+/** Browser-safe native form model. Parsing and terminal rendering are separate consumers of these types. */
+export type FormSpanStyle = "code" | "strong" | "em";
+
+/** A run of inline text; `"\n"` inside `text` is a hard line break (`<br>`). */
+export interface FormSpan {
+	text: string;
+	style?: FormSpanStyle;
+}
+
+export interface ChoiceOption {
+	value: string;
+	label: FormSpan[];
+	checked: boolean;
+	disabled: boolean;
+}
+
+export interface ChoiceField {
+	kind: "choice";
+	name: string;
+	multi: boolean;
+	select: boolean;
+	/** Added only to radio/checkbox groups of two or more options which don't offer their own Other. */
+	other: boolean;
+	label: FormSpan[];
+	options: ChoiceOption[];
+	required: boolean;
+}
+
+export interface TextField {
+	kind: "text";
+	name: string;
+	type: string;
+	multiline: boolean;
+	label: FormSpan[];
+	value: string;
+	placeholder: string;
+	required: boolean;
+	min?: number;
+	max?: number;
+	pattern?: string;
+	minLength?: number;
+	maxLength?: number;
+	rows: number;
+}
+
+export type FormField = ChoiceField | TextField;
+
+export type FormBlock =
+	| { kind: "text"; spans: FormSpan[]; heading: boolean }
+	| { kind: "list"; items: FormSpan[][]; ordered: boolean }
+	| { kind: "pre"; text: string }
+	| { kind: "table"; rows: FormSpan[][][]; headerRows: number }
+	| { kind: "image"; src: string; alt: string }
+	| { kind: "svg"; markup: string; alt: string }
+	| { kind: "field"; field: FormField; optionsEnd?: number };
+
+export interface FormSection {
+	title: FormSpan[];
+	blocks: FormBlock[];
+	fieldset: boolean;
+}
+
+export interface HtmlForm {
+	sections: FormSection[];
+	fields: FormField[];
+	hidden: [name: string, value: string][];
+}
+
+/** Plain text of spans; shared by parser, result formatting and graphical hosts. */
+export function spansText(spans: readonly FormSpan[]): string {
+	return spans.map(span => span.text).join("");
+}
