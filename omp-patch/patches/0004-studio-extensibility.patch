+ * tool call receives a Remote UI context bound to its own internal
+ * commandId (`studio-tool:<toolCallId>`), keeping multi-question Ask flows
+ * on one identity.
+ */
+export type ToolUiFactory = (toolCall?: ToolCallContext) => ExtensionUIContext;
