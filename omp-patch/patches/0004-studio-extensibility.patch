-	setUIContext(uiContext: ExtensionUIContext, hasUI: boolean): void {
-		this.#uiContext = uiContext;
+	setUIContext(uiContext: ExtensionUIContext | ToolUiFactory | undefined, hasUI: boolean): void {
+		if (typeof uiContext === "function") {
+			this.#uiFactory = uiContext;
+			this.#uiContext = undefined;
+		} else {
+			this.#uiContext = uiContext;
+			this.#uiFactory = undefined;
+		}
 		this.#hasUI = hasUI;
