    "@omp-studio/platform-win32": "0.1.8",
    "@omp-studio/runtime-installer": "0.1.8",
    "@omp-studio/studio-host": "0.1.8",
    "@omp-studio/transport-desktop": "0.1.8",
    "builder-util-runtime": "9.7.0",
    "electron-updater": "6.8.9",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@omp-studio/testkit": "0.1.8",
