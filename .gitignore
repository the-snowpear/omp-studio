# Dependencies
node_modules/
.pnp/
.pnp.js

# Build / release output (scoped to our own packages; vendored upstream source
# under omp-patch/vendor/ must NOT match these — it contains .zip fixtures, an
# `out/` dir, etc.)
packages/*/dist/
packages/*/build/
packages/*/out/
packages/*/release/
apps/*/dist/
apps/*/build/
apps/*/out/
*.exe
*.dmg
*.AppImage

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor & OS
.DS_Store
Thumbs.db
.idea/
.vscode/
.cursor/

# WorkBuddy local project data (not meant for public repo)
.workbuddy/

# Local Codex / ZCode / agent session data
.codex-backups/
.codex-tools/
.zcode/
.omp/

# Unpackaged desktop sidecar (avatars etc.); packaged builds use {installDir}/userdata/
apps/desktop/userdata/

# Local Playwright CLI captures and scratch UI dumps
.playwright-cli/
**/__scratch__/

# Task backups, scratch work, and generated audit outputs
backup/
tmp/
output/
outputs/

# Architecture review packs / extracted archives (local working notes, not product code)
architecture_review_v2_work/

# Root scratch images (never product assets)
/spacing-compare.png
/Untitled*.png

# UI experiment dumps (not the ver1/ver2 design reference)
ui_reference/test/

# Local visual QA notes (often contain machine-specific paths)
doc/qa/

# Local agent/IDE config (project skills live under repo .claude only on dev machines)
.claude/
skills-lock.json

# Local generated installer public key (never the private signing key)
packaging/runtime-keys/

# Alternate lockfile (repo uses npm / package-lock.json)
pnpm-lock.yaml
